# Canonical production origin. Optional: when unset, the site defaults to
# https://moorxe.com. Must be a real https public origin — localhost,
# example hosts, *.vercel.app, and credentials are rejected. Setting it
# also marks a non-Vercel build as the indexable production deployment.
SITE_URL=https://moorxe.com

# Contact delivery sink: "local-file" (development only) or "webhook".
# Leave unset in development to persist locally; in production an
# unset sink makes /api/contact answer 503 instead of faking success.
CONTACT_SINK=local-file

# Webhook sink (only when CONTACT_SINK=webhook). Server-only secrets.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Optional public social profile URLs. Only https URLs are rendered;
# anything missing or invalid is simply omitted from the footer.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
